{
  "name": "juiceshop-scrapper",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "socket.io-client": "4.8.4"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "org.owasp.juiceshop.solver.local",
    "productName": "Juice Shop Solver",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Juice-Shop-Solver-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
